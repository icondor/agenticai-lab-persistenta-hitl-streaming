# Modelul care genereaza raspunsuri (ca in Lab 11 si Lab 12)
# Valori: anthropic | gemini | openai | ollama | azureopenai | xai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# Unde se salveaza checkpoint-urile (SqliteSaver). Optional.
# Implicit: date/checkpoints.sqlite, in folderul proiectului.
# CHECKPOINT_DB=date/checkpoints.sqlite
